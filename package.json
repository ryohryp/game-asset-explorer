{
  "name": "game-asset-explorer",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "ryohryp",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/src/entry.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "gameAssetExplorer.scanAssets",
        "title": "%gameAssetExplorer.command.scanAssets%",
        "icon": "$(refresh)"
      },
      {
        "command": "gameAssetExplorer.openAssetGrid",
        "title": "%gameAssetExplorer.command.openAssetGrid%",
        "icon": "$(preview)"
      },
      {
        "command": "gameAssetExplorer.generateNewAssetPrompt",
        "title": "%gameAssetExplorer.command.generateNewAssetPrompt%",
        "icon": "$(sparkle)"
      },
      {
        "command": "gameAssetExplorer.showCategorySummary",
        "title": "%gameAssetExplorer.command.showCategorySummary%",
        "icon": "$(list-tree)"
      },
      {
        "command": "gameAssetExplorer.setAssetSubtype",
        "title": "%gameAssetExplorer.command.setAssetSubtype%"
      },
      {
        "command": "gameAssetExplorer.configureAssetDirectories",
        "title": "%gameAssetExplorer.command.configureAssetDirectories%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gameAssetExplorer.setOpenAiApiKey",
        "title": "%gameAssetExplorer.command.setOpenAiApiKey%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gameAssetExplorer",
          "title": "%gameAssetExplorer.viewContainer.title%",
          "icon": "media/asset-explorer.svg"
        }
      ]
    },
    "views": {
      "gameAssetExplorer": [
        {
          "id": "gameAssetExplorer.explorer",
          "name": "%gameAssetExplorer.view.assets%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gameAssetExplorer.explorer",
        "contents": "%gameAssetExplorer.welcome.noWorkspace%",
        "when": "!gameAssetExplorer.hasWorkspace"
      },
      {
        "view": "gameAssetExplorer.explorer",
        "contents": "%gameAssetExplorer.welcome.configureDirectories%",
        "when": "gameAssetExplorer.hasWorkspace && !gameAssetExplorer.hasUsableAssetDirectories"
      },
      {
        "view": "gameAssetExplorer.explorer",
        "contents": "%gameAssetExplorer.welcome.ready%",
        "when": "gameAssetExplorer.hasUsableAssetDirectories"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gameAssetExplorer.openAssetGrid",
          "when": "view == gameAssetExplorer.explorer && gameAssetExplorer.hasUsableAssetDirectories",
          "group": "navigation@1"
        },
        {
          "command": "gameAssetExplorer.scanAssets",
          "when": "view == gameAssetExplorer.explorer && gameAssetExplorer.hasUsableAssetDirectories",
          "group": "navigation@2"
        },
        {
          "command": "gameAssetExplorer.generateNewAssetPrompt",
          "when": "view == gameAssetExplorer.explorer && gameAssetExplorer.hasUsableAssetDirectories",
          "group": "navigation@3"
        },
        {
          "command": "gameAssetExplorer.showCategorySummary",
          "when": "view == gameAssetExplorer.explorer && gameAssetExplorer.hasUsableAssetDirectories",
          "group": "navigation@4"
        },
        {
          "command": "gameAssetExplorer.configureAssetDirectories",
          "when": "view == gameAssetExplorer.explorer",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "%gameAssetExplorer.configuration.title%",
      "properties": {
        "gameAssetExplorer.assetDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "%gameAssetExplorer.configuration.assetDirectories.description%"
        },
        "gameAssetExplorer.assetProfile": {
          "type": "string",
          "enum": [
            "generic",
            "rpg",
            "action",
            "visual-novel",
            "card-game",
            "custom"
          ],
          "enumDescriptions": [
            "%gameAssetExplorer.configuration.assetProfile.generic%",
            "%gameAssetExplorer.configuration.assetProfile.rpg%",
            "%gameAssetExplorer.configuration.assetProfile.action%",
            "%gameAssetExplorer.configuration.assetProfile.visualNovel%",
            "%gameAssetExplorer.configuration.assetProfile.cardGame%",
            "%gameAssetExplorer.configuration.assetProfile.custom%"
          ],
          "default": "generic",
          "scope": "window",
          "description": "%gameAssetExplorer.configuration.assetProfile.description%"
        },
        "gameAssetExplorer.customAssetTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 32,
          "uniqueItems": true,
          "default": [],
          "scope": "window",
          "description": "%gameAssetExplorer.configuration.customAssetTypes.description%"
        },
        "gameAssetExplorer.assetProfileOverrides": {
          "type": "object",
          "default": {},
          "scope": "window",
          "additionalProperties": false,
          "properties": {
            "addAssetTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 32,
              "uniqueItems": true,
              "default": []
            },
            "removeAssetTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "maxItems": 32,
              "uniqueItems": true,
              "default": []
            },
            "subtypes": {
              "type": "object",
              "default": {},
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "maxItems": 32,
                "uniqueItems": true
              }
            }
          },
          "description": "%gameAssetExplorer.configuration.assetProfileOverrides.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.2"
  }
}
